<UserControl x:Class="ERPiApp.Views.SefPfr.SefFaktureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Pretraga:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtPretraga" Width="220" Height="34" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtPretraga_TextChanged"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnNovaFaktura" Content="➕" Style="{StaticResource IconButtonStyle}" ToolTip="Nova e-Faktura" Click="BtnNovaFaktura_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPosaljiNaSef" Content="🚀" Style="{StaticResource IconButtonStyle}" ToolTip="Pošalji izabranu fakturu na SEF API" Click="BtnPosaljiNaSef_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnOsveziStatus" Content="🔄" Style="{StaticResource IconButtonStyle}" ToolTip="Osveži status sa SEF-a" Click="BtnOsveziStatus_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- LISTA SEF FAKTURA -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="📄 SEF e-Fakture (UBL 2.1)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Top" Margin="0,0,0,12"/>
                <DataGrid x:Name="DgSefFakture" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                          SelectionChanged="DgSefFakture_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Broj dok." Binding="{Binding BrojDokumenta}" Width="120"/>
                        <DataGridTextColumn Header="Datum" Binding="{Binding DatumDokumenta, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                        <DataGridTextColumn Header="Partner / Kupac" Binding="{Binding Partner.Naziv}" Width="*"/>
                        <DataGridTextColumn Header="Tip" Binding="{Binding TipDokumenta}" Width="120"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                        <DataGridTextColumn Header="CIR ID" Binding="{Binding CirId}" Width="130"/>
                        <DataGridTextColumn Header="Ukupno (RSD)" Binding="{Binding Ukupno, StringFormat=\{0:N2\}}" Width="130" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
