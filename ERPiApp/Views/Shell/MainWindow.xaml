<Window x:Class="ERPiApp.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ERPi — Integrisani poslovni sistem"
        Height="768" Width="1280"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource SidebarStartColor}" Offset="0"/>
                    <GradientStop Color="{StaticResource SidebarEndColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,12">
                    <TextBlock Text="🚀 ERPi" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Integrisani poslovni sistem" FontSize="11" Foreground="#38BDF8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Aktivna firma -->
                <Border DockPanel.Dock="Top" Margin="16,0,16,15" Background="#1E293B" CornerRadius="8" Padding="12,10"
                        Cursor="Hand" MouseDown="FirmaBorder_MouseDown" ToolTip="Kliknite za promenu firme">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="Aktivna firma:" FontSize="10" Foreground="#64748B" FontWeight="Bold"/>
                            <Border HorizontalAlignment="Right" Background="#334155" CornerRadius="4" Padding="5,2">
                                <TextBlock Text="🔄 Promeni" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TxtFirmaNaziv" Grid.Row="1" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" Margin="0,4,0,2"/>
                        <TextBlock x:Name="TxtFirmaSifra" Grid.Row="2" Text="—" FontSize="11" Foreground="#38BDF8"/>
                    </Grid>
                </Border>

                <Separator DockPanel.Dock="Top" Background="#334155" Margin="16,0,16,10"/>

                <!-- Korisnik + Odjava -->
                <Border DockPanel.Dock="Bottom" Margin="16,0,16,12" Background="#1E293B" CornerRadius="8" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TxtImeKorisnika" Text="Prijavljeni korisnik" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="TxtUlogaKorisnika" Grid.Row="1" Text="Uloga" FontSize="10" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        <Button x:Name="BtnOdjava" Grid.Row="3" Content="Odjavi se" FontSize="11" Padding="4,4"
                                Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1" Background="Transparent"
                                Cursor="Hand" Click="BtnOdjava_Click"/>
                    </Grid>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Text="v2.0.0-alpha  •  2026"
                           FontSize="11" Foreground="#38BDF8" TextAlignment="Center" Margin="0,0,0,12"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlNavigation">
                        <TextBlock Text="OPŠTE" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" Margin="24,2,0,3"/>
                        <RadioButton x:Name="BtnDashboard" Content="📊 Radna tabla" Style="{StaticResource NavButtonStyle}" IsChecked="True" Click="NavDashboard_Click" ToolTip="Pregled stanja Core šeme"/>

                        <TextBlock Text="FINANSIJE I MAGACIN" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" Margin="24,14,0,3"/>
                        <RadioButton x:Name="BtnNalozi" Content="📖 Glavna knjiga i Nalozi" Style="{StaticResource NavButtonStyle}" Click="NavNalozi_Click" ToolTip="Dnevnik glavne knjige — nalozi i stavke"/>

                        <!-- Ostatak Finansija (Partneri/IOS, Magacin, PDV, SEF) i moduli Sredstva/Zarade dolaze u narednim podfazama -->
                        <TextBlock Text="USKORO" FontSize="10" FontWeight="SemiBold" Foreground="#475569" Margin="24,14,0,3"/>
                        <TextBlock Text="Partneri i otvorene stavke" Foreground="#475569" FontSize="13" Margin="26,6,0,0"/>
                        <TextBlock Text="Magacin i PDV" Foreground="#475569" FontSize="13" Margin="26,6,0,0"/>
                        <TextBlock Text="Osnovna sredstva" Foreground="#475569" FontSize="13" Margin="26,6,0,0"/>
                        <TextBlock Text="Obračun zarada" Foreground="#475569" FontSize="13" Margin="26,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="📊 Radna tabla" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" x:Name="PnlUpozorenjeLozinka" Background="#FEF3C7" Padding="24,10" Visibility="Collapsed">
                <TextBlock Text="⚠️ Nalog koristi podrazumevanu lozinku (admin123) — promenite je pre stvarnog rada. Ekran za upravljanje korisnicima dolazi u sledećoj fazi."
                           FontSize="12" Foreground="#92400E" TextWrapping="Wrap"/>
            </Border>

            <ContentControl x:Name="MainContentHost" Grid.Row="2" Margin="24"/>
        </Grid>
    </Grid>
</Window>
