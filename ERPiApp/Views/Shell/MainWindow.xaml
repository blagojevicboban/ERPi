<Window x:Class="ERPiApp.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ERPi — Integrisani poslovni sistem"
        Height="768" Width="1280"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0">
            <Border.Resources>
                <!-- Transparent RepeatButton for Track -->
                <Style x:Key="ScrollBarTrackButton" TargetType="RepeatButton">
                    <Setter Property="OverridesDefaultStyle" Value="true"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Focusable" Value="false"/>
                    <Setter Property="IsTabStop" Value="false"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RepeatButton">
                                <Border Background="Transparent"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Modern ScrollBar Thumb Style for Dark Background -->
                <Style x:Key="SidebarScrollBarThumb" TargetType="Thumb">
                    <Setter Property="OverridesDefaultStyle" Value="true"/>
                    <Setter Property="IsTabStop" Value="false"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Thumb">
                                <Border x:Name="rectangle"
                                        CornerRadius="3"
                                        Background="#40FFFFFF"
                                        Margin="2,0,2,0"
                                        Width="6"
                                        HorizontalAlignment="Center"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter TargetName="rectangle" Property="Background" Value="#80FFFFFF"/>
                                        <Setter TargetName="rectangle" Property="Width" Value="8"/>
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="true">
                                        <Setter TargetName="rectangle" Property="Background" Value="#A0FFFFFF"/>
                                        <Setter TargetName="rectangle" Property="Width" Value="8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Style for ScrollBar within the Sidebar -->
                <Style TargetType="ScrollBar">
                    <Setter Property="OverridesDefaultStyle" Value="true"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="10"/>
                            <Setter Property="Height" Value="Auto"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid x:Name="Bg" Background="Transparent">
                                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarTrackButton}"/>
                                                </Track.DecreaseRepeatButton>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarTrackButton}"/>
                                                </Track.IncreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb Style="{StaticResource SidebarScrollBarThumb}"/>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Resources>

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="GradStopSidebar1" Color="{StaticResource SidebarStartColor}" Offset="0"/>
                    <GradientStop x:Name="GradStopSidebar2" Color="{StaticResource SidebarEndColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,12">
                    <TextBlock x:Name="TxtBrandTitle" Text="🚀 ERPi" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtBrandSubtitle" Text="Integrisani poslovni sistem" FontSize="11" Foreground="#38BDF8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Aktivna firma -->
                <Border x:Name="BorderFirmaCard" DockPanel.Dock="Top" Margin="16,0,16,15" Background="#20FFFFFF" CornerRadius="8" Padding="12,10"
                        Cursor="Hand" MouseDown="FirmaBorder_MouseDown" ToolTip="Kliknite za promenu firme">
                    <Grid x:Name="PnlFirmaDetails">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="Firma:" FontSize="10" Foreground="#E2E8F0" FontWeight="Bold"/>
                            <Border HorizontalAlignment="Right" Background="#30FFFFFF" CornerRadius="4" Padding="5,2">
                                <TextBlock Text="🔄 Promeni" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TxtFirmaNaziv" Grid.Row="1" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,4,0,2"/>
                        <TextBlock x:Name="TxtFirmaSifra" Grid.Row="2" Text="—" FontSize="11" Foreground="#38BDF8"/>
                    </Grid>
                </Border>

                <Separator DockPanel.Dock="Top" Background="#30FFFFFF" Margin="16,0,16,10"/>

                <!-- Modul Switcher -->
                <Grid x:Name="PnlModulSwitcher" DockPanel.Dock="Top" Margin="16,0,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="TabModulFinansije" Grid.Column="0" Content="📊" FontSize="16" IsChecked="True"
                                 Style="{StaticResource ModulTabButtonStyle}" Click="TabModulFinansije_Click" ToolTip="Finansije — Glavna knjiga, magacin, SEF"/>
                    <RadioButton x:Name="TabModulZarade" Grid.Column="1" Content="👥" FontSize="16"
                                 Style="{StaticResource ModulTabZaradeStyle}" Click="TabModulZarade_Click" ToolTip="Zarade — Obračun zarada, ugovori, PPP-PD"/>
                    <RadioButton x:Name="TabModulSredstva" Grid.Column="2" Content="🏛️" FontSize="16"
                                 Style="{StaticResource ModulTabSredstvaStyle}" Click="TabModulSredstva_Click" ToolTip="Sredstva — Osnovna sredstva"/>
                </Grid>

                <!-- Korisnik + Odjava -->
                <Border x:Name="BorderKorisnikCard" DockPanel.Dock="Bottom" Margin="16,0,16,12" Background="#20FFFFFF" CornerRadius="8" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TxtImeKorisnika" Text="Prijavljeni korisnik" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="TxtUlogaKorisnika" Grid.Row="1" Text="Uloga" FontSize="10" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        <Button x:Name="BtnOdjava" Grid.Row="3" Content="Odjavi se" FontSize="11" Padding="4,4"
                                Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1" Background="Transparent"
                                Cursor="Hand" Click="BtnOdjava_Click"/>
                    </Grid>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" x:Name="VersionText" Text="v2.0.0-alpha  •  2026"
                           FontSize="11" Foreground="#38BDF8" TextAlignment="Center" Margin="0,0,0,12"
                           Cursor="Hand" ToolTip="Prikaži changelog" MouseLeftButtonUp="VersionText_MouseLeftButtonUp"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- FINANSIJE I MAGACIN MODUL -->
                        <StackPanel x:Name="PnlNavFinansije" Visibility="Visible">
                            <!-- 💼 FINANSIJSKO KNJIGOVODSTVO -->
                            <TextBlock Text="FINANSIJSKO KNJIGOVODSTVO" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" Margin="24,6,0,3"/>
                            <RadioButton x:Name="BtnDashboard" Content="📊 Radna tabla" Style="{StaticResource NavButtonStyle}" IsChecked="True" Click="NavDashboard_Click" ToolTip="Radna tabla sa indikatorima i brzim akcijama"/>
                            <RadioButton x:Name="BtnNalozi" Content="📖 Glavna knjiga i Nalozi" Style="{StaticResource NavButtonStyle}" Click="NavNalozi_Click" ToolTip="Evidencija, knjiženje i pregled naloga glavne knjige"/>
                            <RadioButton x:Name="BtnKarticaKonta" Content="📋 Dnevnik i Kartice konta" Style="{StaticResource NavButtonStyle}" Click="NavKarticaKonta_Click" ToolTip="Pregled hronoloških sintetičkih i analitičkih kartica konta"/>
                            <RadioButton x:Name="BtnPartneri" Content="👥 Partneri i Otvorene stavke" Style="{StaticResource NavButtonStyle}" Click="NavPartneri_Click" ToolTip="Analitika kupaca, dobavljača i otvorene stavke (IOS)"/>
                            <RadioButton x:Name="BtnKompenzacije" Content="🤝 Kompenzacije i Cesije" Style="{StaticResource NavButtonStyle}" Click="NavKompenzacije_Click" ToolTip="Dvojne i trojne kompenzacije sa pametnim skeniranjem"/>
                            <RadioButton x:Name="BtnPutniNalozi" Content="🚗 Putni nalozi i Dnevnice" Style="{StaticResource NavButtonStyle}" Click="NavPutniNalozi_Click" ToolTip="Obračun dnevnica, goriva, smeštaja i knjiženje na konto 5330/5340"/>
                            <RadioButton x:Name="BtnBlagajna" Content="💰 Dinarska i Devizna Blagajna" Style="{StaticResource NavButtonStyle}" Click="NavBlagajna_Click" ToolTip="Uplatnice, isplatnice, blagajnički dnevnik (2430/2440)"/>
                            <RadioButton x:Name="BtnMestaTroska" Content="🎯 Mesta troška i Projekti" Style="{StaticResource NavButtonStyle}" Click="NavMestaTroska_Click" ToolTip="Analitika, troškovi i profitabilnost po projektima"/>
                            <RadioButton x:Name="BtnDevizno" Content="💱 Devizno &amp; Valviranje" Style="{StaticResource NavButtonStyle}" Click="NavDevizno_Click" ToolTip="Valviranje deviznih konta i obračun kursnih razlika"/>
                            <RadioButton x:Name="BtnDnevnikGlavneKnjige" Content="📖 Dnevnik glavne knjige" Style="{StaticResource NavButtonStyle}" Click="NavDnevnikGlavneKnjige_Click" ToolTip="Hronološki pregled svih proknjiženih naloga sa ukupnim iznosima"/>
                            <RadioButton x:Name="BtnBrutoBilans" Content="📊 Bruto bilans" Style="{StaticResource NavButtonStyle}" Click="NavBrutoBilans_Click" ToolTip="Bruto bilans — promet i saldo po kontima"/>
                            <RadioButton x:Name="BtnZakljucniList" Content="📑 Zaključni list" Style="{StaticResource NavButtonStyle}" Click="NavZakljucniList_Click" ToolTip="Totali prometa po sintetičkim (3-cifrenim) kontima za period"/>
                            <RadioButton x:Name="BtnVrednovanjeZaliha" Content="📦 Vrednovanje zaliha" Style="{StaticResource NavButtonStyle}" Click="NavVrednovanjeZaliha_Click" ToolTip="Trenutno stanje zaliha po magacinima sa jediničnim cenama i ukupnom vrednošću"/>
                            <RadioButton x:Name="BtnBilansiApr" Content="🏛️ Bilansi (APR)" Style="{StaticResource NavButtonStyle}" Click="NavBilansiApr_Click" ToolTip="Zvanični Bilans stanja, Bilans uspeha, Statistički izveštaj, Cash Flow, Promene na kapitalu i Poreski bilans"/>

                            <!-- 📦 ROBNO KNJIGOVODSTVO -->
                            <Separator Background="#334155" Margin="16,8"/>
                            <TextBlock Text="ROBNO KNJIGOVODSTVO (VP / MP)" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" Margin="24,2,0,3"/>
                            <RadioButton x:Name="BtnRobnoDashboard" Content="📊 Radna tabla" Style="{StaticResource NavButtonStyle}" Click="NavRobnoDashboard_Click" ToolTip="Radna tabla robnog knjigovodstva — vrednost zaliha VP/MP, poslednje kalkulacije/nivelacije i brze akcije"/>
                            <RadioButton x:Name="BtnMagacin" Content="📦 Kalkulacije i Nivelacije" Style="{StaticResource NavButtonStyle}" Click="NavMagacin_Click" ToolTip="Kalkulacije veleprodaje/maloprodaje, magacini i artikli"/>
                            <RadioButton x:Name="BtnRacuniOtpremnice" Content="🧾 Računi - Otpremnice" Style="{StaticResource NavButtonStyle}" Click="NavRacuniOtpremnice_Click" ToolTip="Prodaja robe, fakture i otpremnice kupcima"/>

                            <!-- 🏭 MATERIJALNO KNJIGOVODSTVO -->
                            <Separator Background="#334155" Margin="16,8"/>
                            <TextBlock Text="MATERIJALNO KNJIGOVODSTVO" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" Margin="24,2,0,3"/>
                            <RadioButton x:Name="BtnMaterijalno" Content="📊 Radna tabla" Style="{StaticResource NavButtonStyle}" Click="NavMaterijalno_Click" ToolTip="Radna tabla materijalnog knjigovodstva — vrednost zaliha, poslednji ulazi/trebovanja i brze akcije"/>
                            <RadioButton x:Name="BtnMaterijalnoSkladiste" Content="🏭 Skladište i Zalihe" Style="{StaticResource NavButtonStyle}" Click="NavMaterijalnoSkladiste_Click" ToolTip="Šifarnik materijala, Ulazi, Trebovanja, Primopredaje, Kartice materijala, Bruto bilans"/>

                            <!-- 🧾 POREZI, SEF I FISKALIZACIJA -->
                            <Separator Background="#334155" Margin="16,8"/>
                            <TextBlock Text="POREZI, SEF I FISKALIZACIJA" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" Margin="24,2,0,3"/>
                            <RadioButton x:Name="BtnPdvEvidencija" Content="🧾 PDV Evidencija (KPR/KIR)" Style="{StaticResource NavButtonStyle}" Click="NavPdvEvidencija_Click" ToolTip="Knjiga primljenih i izdatih računa i PP-PDV prijava"/>
                            <RadioButton x:Name="BtnSefPfr" Content="📄 SEF e-Fakture i PFR" Style="{StaticResource NavButtonStyle}" Click="NavSefPfr_Click" ToolTip="SEF e-Fakture (UBL 2.1 API) i PFR e-Fiskalizacija"/>

                            <!-- 📋 MATIČNI PODACI (ŠIFARNICI) -->
                            <Separator Background="#334155" Margin="16,8"/>
                            <TextBlock Text="MATIČNI PODACI (ŠIFARNICI)" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" Margin="24,2,0,3"/>
                            <RadioButton x:Name="BtnKonta" Content="📋 Kontni plan" Style="{StaticResource NavButtonStyle}" Click="NavKonta_Click" ToolTip="Šifarnik konta (sintetika i analitika)"/>

                            <!-- ⚙️ PODEŠAVANJA I SISTEM -->
                            <Separator Background="#334155" Margin="16,8"/>
                            <TextBlock Text="PODEŠAVANJA I SISTEM" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" Margin="24,2,0,3"/>
                            <RadioButton x:Name="BtnUvoz" Content="⚙️ Uvoz podataka Wizard" Style="{StaticResource NavButtonStyle}" Click="NavUvoz_Click" ToolTip="Uvoz podataka iz baze ERPiFinansije ili DOS DBF fajlova"/>
                            <RadioButton x:Name="BtnPodesavanja" Content="🔧 Podešavanja" Style="{StaticResource NavButtonStyle}" Click="NavPodesavanja_Click" ToolTip="Podešavanja aplikacije — info traka, tema, notifikacije"/>
                            <RadioButton x:Name="BtnPomoc" Content="❓ Pomoć &amp; Uputstva" Style="{StaticResource NavButtonStyle}" Click="NavPomoc_Click" ToolTip="Objedinjeni sistem pomoći i korisnička uputstva za sve module (F1)"/>
                        </StackPanel>

                        <!-- ZARADE MODUL (KLONIRANO IZ ERPiZarade) -->
                        <StackPanel x:Name="PnlNavZarade" Visibility="Collapsed">
                            <TextBlock Text="RADNA TABLA" FontSize="10" FontWeight="SemiBold" Foreground="#7986CB" Margin="24,6,0,3"/>
                            <RadioButton x:Name="BtnZaradeDashboard" Content="📊 Radna tabla" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeDashboard_Click"/>

                            <TextBlock Text="OBRAČUNI" FontSize="10" FontWeight="SemiBold" Foreground="#7986CB" Margin="24,10,0,3"/>
                            <RadioButton x:Name="BtnZaradeObracuni" Content="📁 Obračunski periodi" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeObracuni_Click"/>

                            <TextBlock Text="EVIDENCIJA" FontSize="10" FontWeight="SemiBold" Foreground="#7986CB" Margin="24,10,0,3"/>
                            <RadioButton x:Name="BtnZaradeRadnici" Content="👤 Radnici" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeRadnici_Click"/>
                            <RadioButton x:Name="BtnZaradeRadniSati" Content="⏱️ Radni sati" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeRadniSati_Click"/>
                            <RadioButton x:Name="BtnZaradePrimanja" Content="🎁 Ostala primanja" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradePrimanja_Click"/>
                            <RadioButton x:Name="BtnZaradePorezi" Content="⚖️ Porezi i parametri" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradePorezi_Click"/>
                            <RadioButton x:Name="BtnZaradeDoprinosi" Content="📈 Doprinosi" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeDoprinosi_Click"/>
                            <RadioButton x:Name="BtnZaradePlatniRazredi" Content="📊 Platni razredi" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradePlatniRazredi_Click"/>

                            <TextBlock Text="ISPLATE ZARADA" FontSize="10" FontWeight="SemiBold" Foreground="#7986CB" Margin="24,10,0,3"/>
                            <RadioButton x:Name="BtnZaradeIsplate" Content="💸 Isplate u mesecu" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeIsplate_Click"/>
                            <RadioButton x:Name="BtnZaradeObracunPlate" Content="📊 Obračun plate" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeObracunPlate_Click"/>
                            <RadioButton x:Name="BtnZaradeListici" Content="🧾 Platni listići" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeListici_Click"/>
                            <RadioButton x:Name="BtnZaradeBolovanja" Content="🏥 Bolovanja i RFZO" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeBolovanja_Click"/>
                            <RadioButton x:Name="BtnZaradePppPd" Content="📋 PPP-PD — zarade" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradePppPd_Click"/>
                            <RadioButton x:Name="BtnZaradeNalozi" Content="🏦 Nalozi za prenos" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeNalozi_Click"/>
                            <RadioButton x:Name="BtnZaradeKnjizenje" Content="📒 Nalog za knjiženje" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeKnjizenje_Click"/>

                            <TextBlock Text="VAN RADNOG ODNOSA" FontSize="10" FontWeight="SemiBold" Foreground="#7986CB" Margin="24,10,0,3"/>
                            <RadioButton x:Name="BtnZaradePrimaoci" Content="👤 Primaoci po ugovoru" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradePrimaoci_Click"/>
                            <RadioButton x:Name="BtnZaradeIsplateNaknada" Content="💸 Isplate naknada" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeIsplateNaknada_Click"/>
                            <RadioButton x:Name="BtnZaradeUgovori" Content="📝 Ugovori i naknade" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeUgovori_Click"/>
                            <RadioButton x:Name="BtnZaradeVrsteUgovora" Content="📄 Vrste ugovora" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeVrsteUgovora_Click"/>
                            <RadioButton x:Name="BtnZaradeSabloniUgovora" Content="🖋️ Šabloni ugovora" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeSabloniUgovora_Click"/>
                            <RadioButton x:Name="BtnZaradePppPdNaknade" Content="📋 PPP-PD — naknade" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradePppPdNaknade_Click"/>

                            <TextBlock Text="IZVEŠTAJI" FontSize="10" FontWeight="SemiBold" Foreground="#7986CB" Margin="24,10,0,3"/>
                            <RadioButton x:Name="BtnZaradeStampe" Content="📑 Izveštaji &amp; rekapit." Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeStampe_Click"/>
                            <RadioButton x:Name="BtnZaradePppPo" Content="🧾 PPP-PO (godišnja)" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradePppPo_Click"/>

                            <TextBlock Text="ŠIFARNICI ZARADA" FontSize="10" FontWeight="SemiBold" Foreground="#7986CB" Margin="24,10,0,3"/>
                            <RadioButton x:Name="BtnZaradeKrediti" Content="💳 Krediti" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeKrediti_Click"/>
                            <RadioButton x:Name="BtnZaradeBanke" Content="🏦 Banke" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeBanke_Click"/>
                            <RadioButton x:Name="BtnZaradePraznici" Content="📅 Kalendar praznika" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradePraznici_Click"/>
                            <RadioButton x:Name="BtnZaradeVrstePrimanja" Content="💰 Vrste primanja" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeVrstePrimanja_Click"/>
                            <RadioButton x:Name="BtnZaradeOlaksice" Content="🏷️ Poreske olakšice" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeOlaksice_Click"/>
                            <RadioButton x:Name="BtnZaradeKontaKnjizenja" Content="📗 Konta za knjiženje" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradeKontaKnjizenja_Click"/>

                            <TextBlock Text="PODEŠAVANJA" FontSize="10" FontWeight="SemiBold" Foreground="#7986CB" Margin="24,14,0,3"/>
                            <RadioButton x:Name="BtnZaradePodesavanja" Content="⚙️ Podešavanja" Style="{StaticResource NavButtonStyleZarade}" Click="NavZaradePodesavanja_Click" ToolTip="Uvoz podataka iz ERPiZarade i DOS/DBF fajlova"/>
                            <RadioButton x:Name="BtnZaradePomoc" Content="❓ Pomoć &amp; Uputstva" Style="{StaticResource NavButtonStyleZarade}" Click="NavPomoc_Click" ToolTip="Objedinjeni sistem pomoći i korisnička uputstva (F1)"/>
                        </StackPanel>

                        <!-- SREDSTVA MODUL (KLONIRANO IZ ERPiSredstva) -->
                        <StackPanel x:Name="PnlNavSredstva" Visibility="Collapsed">
                            <RadioButton x:Name="BtnSredstvaDashboard" Content="📊 Radna tabla" Style="{StaticResource NavButtonStyleSredstva}" Click="NavSredstvaDashboard_Click" ToolTip="Radna tabla sa KPI karticama i grafikonima osnovnih sredstava"/>
                            <TextBlock Text="OSNOVNA SREDSTVA" FontSize="10" FontWeight="SemiBold" Foreground="#52B788" Margin="24,6,0,3"/>
                            <RadioButton x:Name="BtnSredstvaRegistar" Content="🏛️ Registar sredstava" Style="{StaticResource NavButtonStyleSredstva}" Click="NavSredstvaRegistar_Click" ToolTip="Šifarnik osnovnih sredstava, nalepnice"/>
                            <RadioButton x:Name="BtnSredstvaKartice" Content="📋 Analitičke kartice" Style="{StaticResource NavButtonStyleSredstva}" Click="NavSredstvaKartice_Click" ToolTip="Hronologija promena po sredstvu"/>
                            <RadioButton x:Name="BtnSredstvaPrijave" Content="📥 Prijava sredstava" Style="{StaticResource NavButtonStyleSredstva}" Click="NavSredstvaPrijave_Click" ToolTip="Nalog za prijem/aktiviranje novih sredstava"/>
                            <RadioButton x:Name="BtnSredstvaRashod" Content="📤 Rashod i promene" Style="{StaticResource NavButtonStyleSredstva}" Click="NavSredstvaRashod_Click" ToolTip="Rashodovanje, prodaja, otuđenje, prenos OJ"/>
                            <RadioButton x:Name="BtnSredstvaAmortizacija" Content="📈 Obračun amortizacije" Style="{StaticResource NavButtonStyleSredstva}" Click="NavSredstvaAmortizacija_Click" ToolTip="Obračun i knjiženje amortizacije po periodu"/>
                            <RadioButton x:Name="BtnSredstvaPopis" Content="🗂️ Popis sredstava" Style="{StaticResource NavButtonStyleSredstva}" Click="NavSredstvaPopis_Click" ToolTip="Godišnji popis, komisije, upis stanja"/>
                            <RadioButton x:Name="BtnSredstvaRevalorizacija" Content="💹 Revalorizacija" Style="{StaticResource NavButtonStyleSredstva}" Click="NavSredstvaRevalorizacija_Click" ToolTip="Obračun i knjiženje revalorizacije po koeficijentima"/>
                            <RadioButton x:Name="BtnSredstvaIzvestaji" Content="📊 Izveštaji" Style="{StaticResource NavButtonStyleSredstva}" Click="NavSredstvaIzvestaji_Click" ToolTip="Popis svih sredstava, rekapitulacije po kontu/OJ/am. grupi"/>

                            <TextBlock Text="PODEŠAVANJA" FontSize="10" FontWeight="SemiBold" Foreground="#52B788" Margin="24,14,0,3"/>
                            <RadioButton x:Name="BtnSredstvaPodesavanja" Content="⚙️ Podešavanja" Style="{StaticResource NavButtonStyleSredstva}" Click="NavSredstvaPodesavanja_Click" ToolTip="DOS/DBF uvoz osnovnih sredstava"/>
                            <RadioButton x:Name="BtnSredstvaPomoc" Content="❓ Pomoć &amp; Uputstva" Style="{StaticResource NavButtonStyleSredstva}" Click="NavPomoc_Click" ToolTip="Objedinjeni sistem pomoći i korisnička uputstva (F1)"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleSidebar" Content="☰" Style="{StaticResource IconButtonStyle}" Margin="0,0,16,0"
                            ToolTip="Sklopi / Proširi bočni meni (Ctrl+M)" Click="BtnToggleSidebar_Click"/>
                    <TextBlock x:Name="TxtHeaderTitle" Text="📊 Radna tabla" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" x:Name="PnlUpozorenjeLozinka" Background="#FEF3C7" Padding="24,10" Visibility="Collapsed">
                <TextBlock Text="⚠️ Nalog koristi podrazumevanu lozinku (admin) — promenite je pre stvarnog rada. Ekran za upravljanje korisnicima dolazi u sledećoj fazi."
                           FontSize="12" Foreground="#92400E" TextWrapping="Wrap"/>
            </Border>

            <!-- Bez Margin — svaka strana (Views/**) nosi svoju ivičnu marginu, isto kao u sva tri
                 samostalna app-a (ERPiFinansije/ERPiSredstva/ERPiZarade MainFrame nema Margin).
                 Dupli razmak (ovde + margina stranice) pravio je uočljivo veće ivice nego u ERPiZarade. -->
            <Frame x:Name="MainContentHost" Grid.Row="2" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
