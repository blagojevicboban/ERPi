<Window x:Class="ERPiApp.Views.Magacin.PoreskaTarifaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Poreska tarifa" Height="300" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tarifni broj:" VerticalAlignment="Center" Margin="0,0,0,10" FontWeight="SemiBold"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtTarifniBroj" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10" MaxLength="2"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Porez %:" VerticalAlignment="Center" Margin="0,0,0,10" FontWeight="SemiBold"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtPorezProcenat" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10" Text="20.00"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Poseban porez %:" VerticalAlignment="Center" Margin="0,0,0,10" FontWeight="SemiBold"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtPosebanPorezProcenat" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10" Text="0.00"/>

        <CheckBox Grid.Row="3" Grid.Column="1" x:Name="ChkPorezUCeni" Content="Porez je uračunat u cenu" Margin="0,0,0,10" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnSacuvaj" Content="Sačuvaj" Width="100" Height="34" Margin="0,0,10,0" Style="{StaticResource ActionButtonStyle}" Click="BtnSacuvaj_Click"/>
            <Button x:Name="BtnOtkazi" Content="Otkaži" Width="90" Height="34" Style="{StaticResource SecondaryButton}" Click="BtnOtkazi_Click"/>
        </StackPanel>
    </Grid>
</Window>
