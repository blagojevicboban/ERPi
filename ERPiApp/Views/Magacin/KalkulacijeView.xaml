<UserControl x:Class="ERPiApp.Views.Magacin.KalkulacijeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Magacin:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbMagacinFilter" Width="200" Height="34" VerticalContentAlignment="Center"
                              DisplayMemberPath="Prikaz" SelectedValuePath="MagacinId" SelectionChanged="CmbMagacinFilter_SelectionChanged"/>
                    <TextBlock Text="Pretraga:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="16,0,6,0"/>
                    <TextBox x:Name="TxtPretraga" Width="180" Height="34" VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtPretraga_TextChanged"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnNovaKalkulacija" Content="➕" Style="{StaticResource IconButtonStyle}" ToolTip="Nova ulazna kalkulacija" Click="BtnNovaKalkulacija_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnIzmeniKalkulaciju" Content="✏️" Style="{StaticResource IconButtonStyle}" ToolTip="Izmeni kalkulaciju" Click="BtnIzmeniKalkulaciju_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnObrisiKalkulaciju" Content="🗑️" Style="{StaticResource IconButtonStyle}" ToolTip="Obriši kalkulaciju" Click="BtnObrisiKalkulaciju_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- LISTA KALKULACIJA -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="📊 Ulazne kalkulacije" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Top" Margin="0,0,0,12"/>
                <DataGrid x:Name="DgKalkulacije" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                          SelectionChanged="DgKalkulacije_SelectionChanged" MouseDoubleClick="DgKalkulacije_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Broj kalk." Binding="{Binding BrojKalkulacije}" Width="90"/>
                        <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                        <DataGridTextColumn Header="Magacin" Binding="{Binding Magacin.Prikaz}" Width="160"/>
                        <DataGridTextColumn Header="Dobavljač" Binding="{Binding Partner.Naziv}" Width="*"/>
                        <DataGridTextColumn Header="Faktura dobav." Binding="{Binding BrojFaktureDobavljaca}" Width="130"/>
                        <DataGridTextColumn Header="Nabavni iznos" Binding="{Binding UkupnoNabavna, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="PDV iznos" Binding="{Binding UkupnoPdv, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Prodajni iznos" Binding="{Binding UkupnoProdajna, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
