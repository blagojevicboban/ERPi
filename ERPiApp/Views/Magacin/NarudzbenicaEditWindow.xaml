<Window x:Class="ERPiApp.Views.Magacin.NarudzbenicaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Narudžbenica dobavljaču" Height="660" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        KeyDown="Window_KeyDown">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ZAGLAVLJE -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Dobavljač / Partner:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,12"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbPartner" Height="32" VerticalContentAlignment="Center" Margin="0,0,20,12" DisplayMemberPath="Prikaz" SelectedValuePath="PartnerId"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Magacin prijema: *" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,12"/>
                <ComboBox Grid.Row="0" Grid.Column="3" x:Name="CmbMagacin" Height="32" VerticalContentAlignment="Center" Margin="0,0,20,12" DisplayMemberPath="Prikaz" SelectedValuePath="MagacinId"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="Broj narudžb.:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,12"/>
                <TextBlock Grid.Row="0" Grid.Column="5" x:Name="TxtBrojNarudzbenice" Text="(automatski)" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Datum narudžb.: *" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <DatePicker Grid.Row="1" Grid.Column="1" x:Name="DpDatum" Height="32" VerticalContentAlignment="Center" HorizontalAlignment="Left" Width="150" Margin="0,0,20,0"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Rok isporuke:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <DatePicker Grid.Row="1" Grid.Column="3" x:Name="DpRokIsporuke" Height="32" VerticalContentAlignment="Center" Margin="0,0,20,0"/>

                <TextBlock Grid.Row="1" Grid.Column="4" Text="Napomena:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox Grid.Row="1" Grid.Column="5" x:Name="TxtNapomena" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
            </Grid>
        </Border>

        <!-- STAVKE -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="📋 Naručeni artikli" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="BtnDodajStavku" Content="➕" Style="{StaticResource IconButtonStyle}" ToolTip="Dodaj stavku" Click="BtnDodajStavku_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnObrisiStavku" Content="🗑️" Style="{StaticResource IconButtonStyle}" ToolTip="Obriši izabranu stavku" Click="BtnObrisiStavku_Click"/>
                </StackPanel>

                <DataGrid x:Name="DgStavke" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                          CellEditEnding="DgStavke_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn x:Name="ColArtikal" Header="Artikal *"
                                                 SelectedValueBinding="{Binding ArtikalId}"
                                                 SelectedValuePath="ArtikalId"
                                                 DisplayMemberPath="Prikaz"
                                                 Width="260"/>
                        <DataGridTextColumn Header="Naručeno" Binding="{Binding KolicinaNarucena, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}" EditingElementStyle="{StaticResource NumericColumnEditingStyle}"/>
                        <DataGridTextColumn Header="Pristiglo" Binding="{Binding KolicinaPristigla, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}" EditingElementStyle="{StaticResource NumericColumnEditingStyle}"/>
                        <DataGridTextColumn Header="Nabavna cena" Binding="{Binding Cena, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}" EditingElementStyle="{StaticResource NumericColumnEditingStyle}"/>
                        <DataGridTextColumn Header="PDV %" Binding="{Binding PdvStopa, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="70" ElementStyle="{StaticResource NumericColumnElementStyle}" EditingElementStyle="{StaticResource NumericColumnEditingStyle}"/>
                        <DataGridTextColumn Header="Neto" Binding="{Binding IznosNeto, StringFormat=N2}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="PDV" Binding="{Binding IznosPdv, StringFormat=N2}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Bruto" Binding="{Binding IznosBruto, StringFormat=N2}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- SUMARNI PRIKAZ -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="16,10" CornerRadius="8" Background="#ECFDF5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Ukupno neto: " FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtZbirNeto" Text="0,00 RSD" FontWeight="Bold" Margin="0,0,24,0"/>
                <TextBlock Text="Ukupno PDV: " FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtZbirPdv" Text="0,00 RSD" FontWeight="Bold" Margin="0,0,24,0"/>
                <TextBlock Text="Ukupno bruto: " FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtZbirBruto" Text="0,00 RSD" FontWeight="Bold" Foreground="#047857"/>
            </StackPanel>
        </Border>

        <!-- AKCIJE -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOtkazi" Content="Otkaži" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0" Click="BtnOtkazi_Click"/>
            <Button x:Name="BtnSacuvaj" Content="💾 Sačuvaj narudžbenicu" Style="{StaticResource ActionButtonStyle}" Click="BtnSacuvaj_Click"/>
        </StackPanel>
    </Grid>
</Window>
