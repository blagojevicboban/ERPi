<UserControl x:Class="ERPiApp.Views.Magacin.NarudzbeniceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Pretraga:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtPretraga" Style="{StaticResource SearchTextBoxStyle}" Width="220" Height="34" VerticalContentAlignment="Center" TextChanged="TxtPretraga_TextChanged"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnNovaNarudzbenica" Content="➕ Nova narudžbenica" Style="{StaticResource ActionButtonStyle}" ToolTip="Kreiraj novu narudžbenicu dobavljaču" Click="BtnNovaNarudzbenica_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnIzmeniNarudzbenicu" Content="✏️ Izmeni" Style="{StaticResource ActionButtonStyle}" Background="#4B5563" ToolTip="Izmeni izabranu narudžbenicu" Click="BtnIzmeniNarudzbenicu_Click" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button x:Name="BtnObrisiNarudzbenicu" Content="🗑️ Obriši" Style="{StaticResource ActionButtonStyle}" Background="#EF4444" ToolTip="Obriši izabranu narudžbenicu" Click="BtnObrisiNarudzbenicu_Click" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button x:Name="BtnPretvoriUKalkulaciju" Content="📥 Pretvori u Kalkulaciju" Style="{StaticResource ActionButtonStyle}" Background="#10B981" ToolTip="Pretvori narudžbenicu u ulaznu kalkulaciju" Click="BtnPretvoriUKalkulaciju_Click" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button x:Name="BtnExportExcel" Content="X" FontWeight="Bold" FontSize="20" Style="{StaticResource ActionButtonStyle}" Background="#059669" Width="36" Padding="0" ToolTip="Izvoz narudžbenica u Excel" Click="BtnExportExcel_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- LISTA -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DataGrid x:Name="DgNarudzbenice" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                      SelectionChanged="DgNarudzbenice_SelectionChanged" MouseDoubleClick="DgNarudzbenice_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Broj narudžb." Binding="{Binding BrojNarudzbenice}" Width="130" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                    <DataGridTextColumn Header="Rok isporuke" Binding="{Binding RokIsporuke, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                    <DataGridTextColumn Header="Dobavljač" Binding="{Binding Partner.Naziv}" Width="*"/>
                    <DataGridTextColumn Header="Magacin prijema" Binding="{Binding Magacin.NazivMagacina}" Width="150"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Ukupno Naručeno" Binding="{Binding UkupnoBruto, StringFormat=\{0:N2\}}" Width="140" ElementStyle="{StaticResource NumericColumnElementStyle}" FontWeight="Bold"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- STAVKE -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="📋 Naručeni artikli" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                <DataGrid x:Name="DgNarudzbenicaStavke" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="R.br." Binding="{Binding RedniBroj}" Width="50"/>
                        <DataGridTextColumn Header="Artikal" Binding="{Binding Artikal.Prikaz}" Width="*"/>
                        <DataGridTextColumn Header="Naručeno" Binding="{Binding KolicinaNarucena, StringFormat=\{0:N2\}}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Pristiglo" Binding="{Binding KolicinaPristigla, StringFormat=\{0:N2\}}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Nabavna cena" Binding="{Binding Cena, StringFormat=\{0:N2\}}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Neto" Binding="{Binding IznosNeto, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="PDV" Binding="{Binding IznosPdv, StringFormat=\{0:N2\}}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Bruto" Binding="{Binding IznosBruto, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
