<Window x:Class="ERPiApp.Views.Magacin.NivelacijaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏷️ Zapisnik o nivelaciji cena" Height="620" Width="880"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" KeyDown="Window_KeyDown"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Broj nivelacije:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtBrojNivelacije" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Datum:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="16,0,8,0"/>
                <DatePicker Grid.Row="0" Grid.Column="3" x:Name="DpDatum" Height="32" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="Magacin:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="16,0,8,0"/>
                <ComboBox Grid.Row="0" Grid.Column="5" x:Name="CmbMagacin" Height="32" VerticalContentAlignment="Center" DisplayMemberPath="Prikaz"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Napomena:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,8,8,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" x:Name="TxtOpis" Height="32" VerticalContentAlignment="Center" Padding="6,0" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="📋 Stavke nivelacije cena" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="BtnDodajStavku" Content="➕ Dodaj stavku" Style="{StaticResource ActionButtonStyle}" Margin="20,0,0,0" Click="BtnDodajStavku_Click"/>
                    <Button x:Name="BtnUkloniStavku" Content="🗑️ Ukloni stavku" Style="{StaticResource ActionButtonStyle}" Background="#EF4444" Margin="8,0,0,0" Click="BtnUkloniStavku_Click"/>
                </StackPanel>

                <DataGrid x:Name="DgStavke" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" CellEditEnding="DgStavke_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="R.br." Binding="{Binding RedniBroj}" Width="50" IsReadOnly="True"/>
                        <DataGridComboBoxColumn x:Name="ColArtikal" Header="Artikal *"
                                                  SelectedValueBinding="{Binding ArtikalId}"
                                                  SelectedValuePath="ArtikalId"
                                                  DisplayMemberPath="Prikaz"
                                                  Width="2*"/>
                        <DataGridTextColumn Header="Zaliha" Binding="{Binding KolicinaZaliha, StringFormat=\{0:N2\}}" Width="90"/>
                        <DataGridTextColumn Header="Stara cena" Binding="{Binding StaraCena, StringFormat=\{0:N2\}}" Width="100"/>
                        <DataGridTextColumn Header="Nova cena" Binding="{Binding NovaCena, StringFormat=\{0:N2\}}" Width="100"/>
                        <DataGridTextColumn Header="Razl. / jed." Binding="{Binding RazlikaPoJedinici, StringFormat=\{0:N2\}}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Uk. Razlika" Binding="{Binding UkupnaRazlika, StringFormat=\{0:N2\}}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="TxtUkupno" Text="Ukupna razlika: 0,00 RSD" FontSize="14" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,24,0"/>
            <Button Content="💾 Sačuvaj Zapisnik" Style="{StaticResource ActionButtonStyle}" Width="150" Height="36" Margin="0,0,8,0" Click="BtnSacuvaj_Click"/>
            <Button Content="Odustani" Style="{StaticResource ActionButtonStyle}" Background="#64748B" Width="90" Height="36" IsCancel="True" Click="BtnOdustani_Click"/>
        </StackPanel>
    </Grid>
</Window>
