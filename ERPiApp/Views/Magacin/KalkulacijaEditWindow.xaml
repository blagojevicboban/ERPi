<Window x:Class="ERPiApp.Views.Magacin.KalkulacijaEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ulazna kalkulacija" Height="680" Width="1020"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ZAGLAVLJE KALKULACIJE -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Magacin: *" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,12"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbMagacin" Height="32" VerticalContentAlignment="Center" Margin="0,0,20,12" DisplayMemberPath="Prikaz" SelectedValuePath="MagacinId"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Dobavljač:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,12"/>
                <ComboBox Grid.Row="0" Grid.Column="3" x:Name="CmbPartner" Height="32" VerticalContentAlignment="Center" Margin="0,0,20,12" DisplayMemberPath="Naziv" SelectedValuePath="PartnerId"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="Broj kalkulacije:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,12"/>
                <TextBlock Grid.Row="0" Grid.Column="5" x:Name="TxtBrojKalkulacije" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Datum: *" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <DatePicker Grid.Row="1" Grid.Column="1" x:Name="DpDatum" Height="32" VerticalContentAlignment="Center" Margin="0,0,20,0"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Br. fakture dob.:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="TxtBrojFakture" Height="32" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,20,0"/>

                <TextBlock Grid.Row="1" Grid.Column="4" Text="Napomena:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox Grid.Row="1" Grid.Column="5" x:Name="TxtNapomena" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
            </Grid>
        </Border>

        <!-- STAVKE -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="📋 Stavke kalkulacije" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="BtnDodajStavku" Content="➕" Style="{StaticResource IconButtonStyle}" ToolTip="Dodaj stavku" Click="BtnDodajStavku_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnObrisiStavku" Content="🗑️" Style="{StaticResource IconButtonStyle}" ToolTip="Obriši izabranu stavku" Click="BtnObrisiStavku_Click"/>
                </StackPanel>

                <DataGrid x:Name="DgStavke" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                          CellEditEnding="DgStavke_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn x:Name="ColArtikal" Header="Artikal *"
                                                 SelectedValueBinding="{Binding ArtikalId}"
                                                 SelectedValuePath="ArtikalId"
                                                 DisplayMemberPath="Prikaz"
                                                 Width="240"/>
                        <DataGridTextColumn Header="Količina" Binding="{Binding Kolicina, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}" EditingElementStyle="{StaticResource NumericColumnEditingStyle}"/>
                        <DataGridTextColumn Header="Nabavna cena" Binding="{Binding NabavnaCena, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}" EditingElementStyle="{StaticResource NumericColumnEditingStyle}"/>
                        <DataGridTextColumn Header="Rabat %" Binding="{Binding RabatProcenat, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="80" ElementStyle="{StaticResource NumericColumnElementStyle}" EditingElementStyle="{StaticResource NumericColumnEditingStyle}"/>
                        <DataGridTextColumn Header="Marža %" Binding="{Binding MarzaProcenat, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="80" ElementStyle="{StaticResource NumericColumnElementStyle}" EditingElementStyle="{StaticResource NumericColumnEditingStyle}"/>
                        <DataGridTextColumn Header="PDV %" Binding="{Binding PdvStopa, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="70" ElementStyle="{StaticResource NumericColumnElementStyle}" EditingElementStyle="{StaticResource NumericColumnEditingStyle}"/>
                        <DataGridTextColumn Header="Prodajna cena" Binding="{Binding ProdajnaCena, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}" EditingElementStyle="{StaticResource NumericColumnEditingStyle}"/>
                        <DataGridTextColumn Header="Nabavni iznos" Binding="{Binding IznosNabavni, StringFormat=N2}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Prodajni iznos" Binding="{Binding IznosProdajni, StringFormat=N2}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- SUMARNI PRIKAZ -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="16,10" CornerRadius="8" Background="#ECFDF5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Ukupno nabavno: " FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtZbirNabavni" Text="0,00 RSD" FontWeight="Bold" Margin="0,0,24,0"/>
                <TextBlock Text="Ukupno PDV: " FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtZbirPdv" Text="0,00 RSD" FontWeight="Bold" Margin="0,0,24,0"/>
                <TextBlock Text="Ukupno prodajno: " FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtZbirProdajni" Text="0,00 RSD" FontWeight="Bold" Foreground="#047857"/>
            </StackPanel>
        </Border>

        <!-- AKCIJE -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOtkazi" Content="Otkaži" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0" Click="BtnOtkazi_Click"/>
            <Button x:Name="BtnSacuvaj" Content="💾 Sačuvaj kalkulaciju" Style="{StaticResource ActionButtonStyle}" Click="BtnSacuvaj_Click"/>
        </StackPanel>
    </Grid>
</Window>
