<UserControl x:Class="ERPiApp.Views.Magacin.MagacinMainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TabControl x:Name="TabMainMagacin" BorderThickness="0" Background="Transparent" SelectionChanged="TabMainMagacin_SelectionChanged">
            <TabItem Header="📜 Ponude &amp; Predračuni">
                <ContentControl x:Name="HostPonude"/>
            </TabItem>
            <TabItem Header="🛒 Narudžbenice Dobavljačima">
                <ContentControl x:Name="HostNarudzbenice"/>
            </TabItem>
            <TabItem Header="📊 Ulazne kalkulacije">
                <ContentControl x:Name="HostKalkulacije"/>
            </TabItem>
            <TabItem Header="🏷️ Nivelacije cena">
                <ContentControl x:Name="HostNivelacije"/>
            </TabItem>
            <TabItem Header="🛒 MP kalkulacije">
                <ContentControl x:Name="HostMaloprodaja"/>
            </TabItem>
            <TabItem Header="🌍 Uvozne kalkulacije">
                <ContentControl x:Name="HostUvoz"/>
            </TabItem>
            <TabItem Header="📦 Šifarnik artikala">
                <ContentControl x:Name="HostArtikli"/>
            </TabItem>
            <TabItem Header="🏭 Šifarnik magacina">
                <ContentControl x:Name="HostMagacini"/>
            </TabItem>
            <TabItem Header="🏛️ Poreske tarife">
                <ContentControl x:Name="HostPoreskeTarife"/>
            </TabItem>
            <TabItem Header="🔄 Primopredaje">
                <ContentControl x:Name="HostPrimopredaje"/>
            </TabItem>
            <TabItem Header="📥 Zaduženja">
                <ContentControl x:Name="HostZaduzenja"/>
            </TabItem>
            <TabItem Header="📤 Razduženja">
                <ContentControl x:Name="HostRazduzenja"/>
            </TabItem>
            <TabItem Header="📇 Robne kartice">
                <ContentControl x:Name="HostRobneKartice"/>
            </TabItem>
            <TabItem Header="📊 Robni Bruto bilans">
                <ContentControl x:Name="HostRobniBrutoBilans"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
