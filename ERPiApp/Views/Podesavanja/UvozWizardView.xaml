<UserControl x:Class="ERPiApp.Views.Podesavanja.UvozWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="📥 Uvoz podataka iz postojeće ERPiFinansije instalacije" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Omogućava direktan prenos svih matičnih podataka, naloga glavne knjige, kalkulacija i PDV evidencije iz stare baza.db u novu ujedinjenu bazu."
                           FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- FORMA ZA UVOZ -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Putanja do stare baza.db datoteke:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPutanjaBaze" Grid.Column="0" Height="36" VerticalContentAlignment="Center" Padding="8,0" Text="%LocalAppData%\ERPiFinansije\Baze\baza.db"/>
                    <Button x:Name="BtnIzaberiBazu" Grid.Column="1" Content="📁 Izaberi bazu..." Height="36" Padding="16,0" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnIzaberiBazu_Click"/>
                </Grid>

                <Border x:Name="PnlStatistika" Visibility="Collapsed" Margin="0,0,0,20" Padding="16" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="📊 Pronađeni podaci za uvoz:" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtStatistika" Text="—" FontSize="12" Foreground="#334155" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnAnaliziraj" Content="🔍 Analiziraj podatak" Height="38" Padding="18,0" Margin="0,0,12,0" Style="{StaticResource SecondaryButton}" Click="BtnAnaliziraj_Click"/>
                    <Button x:Name="BtnPokreniUvoz" Content="⚡ Uvoz iz ERPiFinansije" Height="38" Padding="20,0" Margin="0,0,12,0" Style="{StaticResource ActionButtonStyle}" Click="BtnPokreniUvoz_Click"/>
                    <Button x:Name="BtnPokreniUvozZarade" Content="💼 Uvoz iz ERPiZarade" Height="38" Padding="20,0" Style="{StaticResource ActionButtonStyle}" Click="BtnPokreniUvozZarade_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
