<Page x:Class="ERPiApp.Views.Pomoc.PomocPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Pomoć i Korisnička Uputstva"
      Background="{StaticResource SurfaceBrush}"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR (MODULE FILTERS & BUTTONS) -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10">
            <DockPanel>
                <!-- HTML & CHANGELOG BUTTONS ON THE RIGHT -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnOtvoriHtml" Content="🌐 Otvori HTML Uputstvo" Style="{StaticResource ActionButtonStyle}" Click="BtnOtvoriHtml_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnChangelog" Content="📜 Changelog" Style="{StaticResource SecondaryButton}" Click="BtnChangelog_Click"/>
                </StackPanel>

                <!-- MODULE FILTER BUTTONS -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📁 Modul:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="RadFilterSve" Content="🌐 Sva uputstva" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" Margin="0,0,6,0" IsChecked="True" Click="Filter_Click"/>
                    <RadioButton x:Name="RadFilterFinansije" Content="💰 Finansije" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" Margin="0,0,6,0" Click="Filter_Click"/>
                    <RadioButton x:Name="RadFilterSredstva" Content="🏗️ Sredstva" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" Margin="0,0,6,0" Click="Filter_Click"/>
                    <RadioButton x:Name="RadFilterZarade" Content="👥 Zarade" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" Margin="0,0,6,0" Click="Filter_Click"/>
                    <RadioButton x:Name="RadFilterOpste" Content="⚙️ Opšte" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,6" Click="Filter_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN HELP CONTENT (LEFT SIDEBAR + RIGHT READER) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: TOPICS SEARCH AND LIST -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                <DockPanel>
                    <TextBlock Text="❓ Teme pomoći" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Top" Margin="0,0,0,12"/>
                    <TextBox x:Name="TxtPretragaTema" DockPanel.Dock="Top" Margin="0,0,0,10" Padding="8,6" FontSize="12"
                             ToolTip="Pretraga tema po nazivu ili sadržaju" TextChanged="TxtPretragaTema_TextChanged"/>
                    <ListBox x:Name="LstTeme" BorderThickness="0" Background="Transparent" SelectionChanged="LstTeme_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Naslov}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Modul}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- RIGHT PANEL: TOPIC READER -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlReader">
                        <DockPanel Margin="0,0,0,12">
                            <Border x:Name="PnlModulBadge" DockPanel.Dock="Right" Background="{StaticResource PrimaryBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtModulTag" Text="Opšte" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock x:Name="TxtNaslovTeme" Text="Dobrodošli u ERPi" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </DockPanel>
                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>
                        <TextBox x:Name="TxtSadrzajTeme" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Disabled"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
