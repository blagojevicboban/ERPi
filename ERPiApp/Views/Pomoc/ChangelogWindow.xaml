<Window x:Class="ERPiApp.Views.Pomoc.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📜 Istorija Izmena (Changelog)" Height="600" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource SurfaceBrush}" KeyDown="Window_KeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="📜 Istorija izmena ERPi" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Evidencija svih verzija, novih funkcija i poboljšanja" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PnlChangelog"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Zatvori (Esc)" Width="120" Height="36" Style="{StaticResource SecondaryButton}" Click="BtnZatvori_Click"/>
        </StackPanel>
    </Grid>
</Window>
