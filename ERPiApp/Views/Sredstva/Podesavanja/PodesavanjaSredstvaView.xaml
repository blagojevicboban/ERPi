<UserControl x:Class="ERPiApp.Views.Sredstva.Podesavanja.PodesavanjaSredstvaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}">

    <UserControl.Resources>
        <!-- Isti TabControl/TabItem stil kao PodesavanjaZaradeView, za vizuelnu doslednost. -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Border" Property="Background" Value="#F0F4F8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderThickness="0">

            <!-- TAB: Uvoz podataka -->
            <TabItem Header="📥 Uvoz podataka">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>

                        <!-- DOS uvoz (direktno iz DBF fajlova) -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="🗄️ DOS uvoz (direktno iz DBF fajlova)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Uvoz osnovnih sredstava, kartica, rashoda i prijava iz starih DOS/Clipper DBF fajlova (SREDSTVA, KARTICA, RASHOD, PRIJAVA, KONTPLAN, KORISNIC)." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                                <Border Background="#FFF3CD" CornerRadius="8" Padding="12" Margin="0,0,0,16" BorderBrush="#FFEBA0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="⚠️ VAŽNO UPOZORENJE" FontWeight="Bold" Foreground="#856404" FontSize="13" Margin="0,0,0,4"/>
                                        <TextBlock Text="DBF fajlovi se prvo učitavaju u privremenu bazu, a zatim se odatle uvoze. Postojeća sredstva (po inventarskom broju) se ne dupliraju — ponovno pokretanje nad istim fajlovima je bezbedno." TextWrapping="Wrap" Foreground="#856404" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="BtnOtvoriDosUvoz" Content="⚡ Uvoz i migracija DOS/DBF podataka..." Height="38" Padding="20,0" HorizontalAlignment="Left" Style="{StaticResource ActionButtonStyle}" Click="BtnOtvoriDosUvoz_Click"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
