<Window x:Class="ERPiApp.Views.Firma.NovaFirmaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova firma" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nova firma" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Naziv firme *" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtNaziv" Height="38" FontSize="14" VerticalContentAlignment="Center" Padding="10,0"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Šifra" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtSifra" Height="38" FontSize="14" VerticalContentAlignment="Center" Padding="10,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="PIB" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtPib" Height="38" FontSize="14" VerticalContentAlignment="Center" Padding="10,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Matični broj" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtMaticniBroj" Height="38" FontSize="14" VerticalContentAlignment="Center" Padding="10,0"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="TxtError" Foreground="#DC2626" TextWrapping="Wrap" VerticalAlignment="Bottom" Visibility="Collapsed"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOdustani" Content="Odustani" Style="{StaticResource SecondaryButton}" Width="110" Margin="0,0,10,0" Click="BtnOdustani_Click"/>
            <Button x:Name="BtnKreiraj" Content="Kreiraj" Style="{StaticResource ActionButtonStyle}" Width="110" Click="BtnKreiraj_Click"/>
        </StackPanel>
    </Grid>
</Window>
