<Window x:Class="ERPiApp.Views.Finansije.Nalozi.PreknjizavanjeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preknjižavanje konta" Height="360" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" KeyDown="Window_KeyDown" Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🔄 Preknjižavanje konta" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Zamenjuje konto na svim stavkama naloga knjiženja (analogno DOS proceduri prekm)." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Staro konto (za zamenu) *" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbStaroKonto" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,14"
                      DisplayMemberPath="Prikaz" SelectedValuePath="KontoId" IsEditable="True" StaysOpenOnEdit="True"/>

            <TextBlock Text="Novo konto *" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbNovoKonto" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,14"
                      DisplayMemberPath="Prikaz" SelectedValuePath="KontoId" IsEditable="True" StaysOpenOnEdit="True"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Odustani" Width="100" Height="36" Margin="0,0,10,0" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="BtnOdustani_Click"/>
            <Button Content="🔄 Preknjiži" Width="120" Height="36" Style="{StaticResource PrimaryButtonStyle}" Background="#7C3AED" Click="BtnIzvrsi_Click"/>
        </StackPanel>
    </Grid>
</Window>
