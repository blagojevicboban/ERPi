<Window x:Class="ERPiApp.Views.Finansije.Nalozi.NalogEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nalog za knjiženje" Height="680" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ZAGLAVLJE NALOGA -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Broj naloga:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtBrojNaloga" Width="80" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,24,0"/>

                <TextBlock Text="Datum: *" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <DatePicker x:Name="DpDatum" Width="140" Height="32" VerticalContentAlignment="Center" Margin="0,0,24,0"/>

                <TextBlock Text="Vrsta:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtVrsta" Width="140" Height="32" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,24,0"/>

                <TextBlock Text="Opis:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtOpisNaloga" Width="300" Height="32" VerticalContentAlignment="Center" Padding="6,0"/>
            </StackPanel>
        </Border>

        <!-- STAVKE -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="📋 Stavke naloga" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="BtnDodajStavku" Content="➕" Style="{StaticResource IconButtonStyle}" ToolTip="Dodaj stavku" Click="BtnDodajStavku_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnObrisiStavku" Content="🗑️" Style="{StaticResource IconButtonStyle}" ToolTip="Obriši izabranu stavku" Click="BtnObrisiStavku_Click"/>
                </StackPanel>

                <DataGrid x:Name="DgStavke" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                          CellEditEnding="DgStavke_CellEditEnding" PreviewKeyDown="DgStavke_PreviewKeyDown">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="R.br." Binding="{Binding RedniBroj}" Width="50" IsReadOnly="True"/>
                        <DataGridComboBoxColumn x:Name="ColKonto" Header="Konto * (F2)"
                                                 SelectedValueBinding="{Binding KontoId}"
                                                 SelectedValuePath="KontoId"
                                                 DisplayMemberPath="Prikaz"
                                                 Width="240"/>
                        <DataGridComboBoxColumn x:Name="ColPartner" Header="Partner"
                                                 SelectedValueBinding="{Binding PartnerId}"
                                                 SelectedValuePath="PartnerId"
                                                 DisplayMemberPath="Prikaz"
                                                 Width="180"/>
                        <DataGridComboBoxColumn x:Name="ColMestoTroska" Header="Mesto troška"
                                                 SelectedValueBinding="{Binding MestoTroskaId}"
                                                 SelectedValuePath="MestoTroskaId"
                                                 DisplayMemberPath="Naziv"
                                                 Width="140"/>
                        <DataGridTextColumn Header="Dokument" Binding="{Binding BrojDokumenta, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn Header="Opis" Binding="{Binding Opis, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="Duguje (RSD)" Binding="{Binding Duguje, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}" EditingElementStyle="{StaticResource NumericColumnEditingStyle}"/>
                        <DataGridTextColumn Header="Potražuje (RSD)" Binding="{Binding Potrazuje, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}" EditingElementStyle="{StaticResource NumericColumnEditingStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- BALANS -->
        <Border x:Name="BorderBalans" Grid.Row="2" Margin="0,16,0,0" Padding="16,10" CornerRadius="8" Background="#ECFDF5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Duguje: " FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtZbirDuguje" Text="0,00" Margin="0,0,24,0"/>
                <TextBlock Text="Potražuje: " FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtZbirPotrazuje" Text="0,00" Margin="0,0,24,0"/>
                <TextBlock x:Name="TxtBalansStatus" Text="⚠️ Nema stavki" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- AKCIJE -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOtkazi" Content="Otkaži" Style="{StaticResource SecondaryButton}" Width="110" Margin="0,0,10,0" Click="BtnOtkazi_Click"/>
            <Button x:Name="BtnRaskniziIIzmeni" Content="🔓 Rasknjiži i izmeni" Style="{StaticResource ActionButtonStyle}" Background="#DC2626" Margin="0,0,10,0" Click="BtnRaskniziIIzmeni_Click" Visibility="Collapsed"/>
            <Button x:Name="BtnSacuvajNacrt" Content="💾 Sačuvaj kao nacrt" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="BtnSacuvajNacrt_Click"/>
            <Button x:Name="BtnProknjizi" Content="✅ Sačuvaj i proknjiži" Style="{StaticResource ActionButtonStyle}" Click="BtnProknjizi_Click"/>
        </StackPanel>
    </Grid>
</Window>
