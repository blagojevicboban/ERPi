<Window x:Class="ERPiApp.Views.Finansije.Partneri.IosIzvestajWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IOS izveštaj — svi partneri" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.1*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📑 IOS izveštaj — otvorene stavke, svi partneri" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

        <!-- FILTERI -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Na dan:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DpNaDan" Width="130" Margin="0,0,16,0"/>
                    <TextBlock Text="Konto (prefiks):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtKontoPrefix" Width="100" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkSamoOtvorene" Content="Samo otvorene" IsChecked="True" VerticalAlignment="Center"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" x:Name="BtnOsvezi" Content="🔄" Style="{StaticResource IconButtonStyle}" ToolTip="Osveži izveštaj" HorizontalAlignment="Right" Click="BtnOsvezi_Click"/>
            </DockPanel>
        </Border>

        <!-- PARTNERI SA SALDOM -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="👥 Partneri sa otvorenim stavkama" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Top" Margin="0,0,0,12"/>
                <DataGrid x:Name="DgPartneri" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                          SelectionChanged="DgPartneri_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Šifra" Binding="{Binding SifraPartnera}" Width="100"/>
                        <DataGridTextColumn Header="Naziv" Binding="{Binding NazivPartnera}" Width="*"/>
                        <DataGridTextColumn Header="PIB" Binding="{Binding Pib}" Width="110"/>
                        <DataGridTextColumn Header="Broj stavki" Binding="{Binding BrojStavki}" Width="90" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Saldo duga (RSD)" Binding="{Binding Saldo, StringFormat=\{0:N2\}}" Width="140" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="#E2E8F0"/>

        <!-- STAVKE IZABRANOG PARTNERA -->
        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="16" Margin="0,16,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock x:Name="TxtStavkeNaslov" Text="📋 Stavke" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" DockPanel.Dock="Top" Margin="0,0,0,12"/>
                <DataGrid x:Name="DgStavke" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Konto" Binding="{Binding Konto}" Width="150"/>
                        <DataGridTextColumn Header="Datum" Binding="{Binding Datum, StringFormat=\{0:dd.MM.yyyy\}}" Width="90"/>
                        <DataGridTextColumn Header="Br. naloga" Binding="{Binding BrojNaloga}" Width="80"/>
                        <DataGridTextColumn Header="Opis" Binding="{Binding Opis}" Width="*"/>
                        <DataGridTextColumn Header="Strana" Binding="{Binding Strana}" Width="80"/>
                        <DataGridTextColumn Header="Iznos (RSD)" Binding="{Binding OriginalniIznos, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Preostalo (RSD)" Binding="{Binding Preostalo, StringFormat=\{0:N2\}}" Width="120" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                        <DataGridTextColumn Header="Dana kašnjenja" Binding="{Binding DanaKasnjenja}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
