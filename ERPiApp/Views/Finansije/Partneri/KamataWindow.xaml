<Window x:Class="ERPiApp.Views.Finansije.Partneri.KamataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Obračun kamate" Height="680" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtNaslovPartnera" Grid.Row="0" Text="💰 Obračun kamate" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

        <!-- KAMATNE STOPE -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Kamatne stope" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Nova stopa od:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DpNovaStopaOd" Width="130" Margin="0,0,10,0"/>
                    <TextBlock Text="Godišnja stopa (%):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtNovaStopaProcenat" Width="80" Height="30" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,10,0"/>
                    <Button x:Name="BtnDodajStopu" Content="➕" Style="{StaticResource IconButtonStyle}" ToolTip="Dodaj stopu" Click="BtnDodajStopu_Click"/>
                </StackPanel>
                <DataGrid x:Name="DgStope" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Background="Transparent" BorderThickness="0" MaxHeight="140">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Važi od" Binding="{Binding DatumOd, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                        <DataGridTextColumn Header="Godišnja stopa (%)" Binding="{Binding GodisnjaStopaProcenat, StringFormat=\{0:N2\}}" Width="140" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Napomena" Binding="{Binding Napomena}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- OBRAČUN -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Obračunata kamata po stavkama" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Datum obračuna:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="DpDatumObracuna" Width="130" Margin="0,0,10,0"/>
                        <Button x:Name="BtnObracunaj" Content="🧮 Obračunaj" Style="{StaticResource SecondaryButton}" Width="130" Click="BtnObracunaj_Click"/>
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="DgKamata" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Datum duga" Binding="{Binding Datum, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
                        <DataGridTextColumn Header="Br. naloga" Binding="{Binding BrojNaloga}" Width="80"/>
                        <DataGridTextColumn Header="Opis" Binding="{Binding Opis}" Width="*"/>
                        <DataGridTextColumn Header="Iznos (RSD)" Binding="{Binding Iznos, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Dana kašnjenja" Binding="{Binding BrojDanaKasnjenja}" Width="100" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                        <DataGridTextColumn Header="Kamata (RSD)" Binding="{Binding ObracunataKamata, StringFormat=\{0:N2\}}" Width="110" ElementStyle="{StaticResource NumericColumnElementStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="Ukupna kamata (RSD):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <TextBlock x:Name="TxtUkupnaKamata" Text="0,00" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="TxtError" Foreground="#DC2626" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" Margin="0,0,16,0" Visibility="Collapsed"/>
            <Button x:Name="BtnZatvoriProzor" Content="Zatvori" Style="{StaticResource SecondaryButton}" Width="110" Margin="0,0,10,0" Click="BtnZatvoriProzor_Click"/>
            <Button x:Name="BtnProknjizi" Content="📖 Proknjiži kamatu" Style="{StaticResource ActionButtonStyle}" Width="160" Click="BtnProknjizi_Click"/>
        </StackPanel>
    </Grid>
</Window>
