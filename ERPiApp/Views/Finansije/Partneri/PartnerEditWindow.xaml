<Window x:Class="ERPiApp.Views.Finansije.Partneri.PartnerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Partner" Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtNaslov" Text="Partner" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Šifra" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtSifra" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Naziv *" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtNaziv" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Adresa" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtAdresa" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PIB" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPib" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Matični broj" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtMaticniBroj" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="JMBG" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtJmbg" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Telefon" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtTelefon" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtEmail" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Žiro račun" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtZiroRacun" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tekući račun" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtBankovniRacun" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Naziv banke" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtNazivBanke" Height="36" VerticalContentAlignment="Center" Padding="8,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Uloge" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <CheckBox x:Name="ChkDobavljac" Content="Dobavljač" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkKupac" Content="Kupac" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkRadnik" Content="Radnik" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkBanka" Content="Banka" Margin="0,0,20,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkPoreskaUprava" Content="Poreska uprava" VerticalAlignment="Center"/>
                    </WrapPanel>
                </StackPanel>

                <CheckBox x:Name="ChkAktivan" Content="Aktivan" IsChecked="True" Margin="0,0,0,8"/>

                <TextBlock x:Name="TxtError" Foreground="#DC2626" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnOtkazi" Content="Otkaži" Style="{StaticResource SecondaryButton}" Width="110" Margin="0,0,10,0" Click="BtnOtkazi_Click"/>
            <Button x:Name="BtnSacuvaj" Content="💾 Sačuvaj" Style="{StaticResource ActionButtonStyle}" Width="130" Click="BtnSacuvaj_Click"/>
        </StackPanel>
    </Grid>
</Window>
